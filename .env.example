POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=APP_DATABASE
POSTGRES_USER=APP_USER
POSTGRES_PASSWORD=APP_PASSWORD
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@localhost:5432/APP_DATABASE
SESSION_SECRET=change-me-at-least-32-characters
METABASE_SITE_URL=
# Usuario y clave quedan solo para administracion local de Metabase.
# La app no usa estas credenciales para embeber dashboards.
METABASE_USERNAME=
METABASE_PASSWORD=
METABASE_DATABASE_ID=

# Google Drive push notifications. El webhook publico de Next recibe el evento
# y llama al workflow incremental unico de n8n.
GOOGLE_DRIVE_WEBHOOK_CHANNEL_ID=
GOOGLE_DRIVE_WEBHOOK_TOKEN=
GOOGLE_DRIVE_WEBHOOK_URL=
N8N_DRIVE_INCREMENTAL_WEBHOOK_URL=
N8N_DRIVE_INCREMENTAL_WEBHOOK_TOKEN=
